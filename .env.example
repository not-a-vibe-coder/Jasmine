OWNERS_USERNAME=@jackdotsol_
# Permanent owner IDs (survive username changes). Send /whoami to the bot to get yours.
OWNER_IDS=

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=@JasmineMemBot

# Walrus Memory (mainnet). Create the account + delegate key at https://memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_ACCOUNT_ID=0x...
MEMWAL_DELEGATE_KEY=hex_ed25519_delegate_private_key

# AI providers, tried in this order. Leave a key empty to skip that provider.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
GEMINI_API_KEY=
# Optional comma-separated model overrides per provider
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# CEREBRAS_MODELS=qwen-3.8-27b,gpt-oss-120b
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# MISTRAL_MODELS=mistral-small-latest
# HF_MODELS=openai/gpt-oss-120b

# Voice notes. Incoming: Groq Whisper (Gemini fallback). Outgoing: Groq Orpheus if you accept
# its terms once at console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# (needs ffmpeg, included in the Docker image), otherwise Microsoft Edge neural voices.
VOICE_NAME=en-US-AvaMultilingualNeural
# VOICE_NAME=en-NG-EzinneNeural   # Nigerian English
ORPHEUS_VOICE=tara

# Reactions and stickers need no keys. GIFs need a free key from developers.giphy.com
GIPHY_API_KEY=
# STICKER_SETS=UtyaDuck,HotCherry,MrCat,PepeTheFrog

# Hugging Face FLUX images (free monthly credits); HF_TOKEN is shared with the chat fallback
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Image generation. A free key from https://enter.pollinations.ai unlocks better models and
# higher limits; without it only Pollinations' small keyless model is used.
POLLINATIONS_API_KEY=
# POLLINATIONS_MODELS=tongyi-mai/z-image-turbo,black-forest-labs/flux.2-klein-4b,black-forest-labs/flux.1-schnell
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Storage (optional; falls back to in-memory)
REDIS_URL=rediss://default:password@host:port
DATABASE_URL=postgresql://user:password@host:port/postgres

# Wallets: run `go run ./cmd/genwallet` to create fresh ones straight into .env
SVM_WALLET_PUBLIC_KEY=
SVM_WALLET_PRIVATE_KEY=
EVM_WALLET_PUBLIC_KEY=
EVM_WALLET_PRIVATE_KEY=

SVM_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BNB_RPC_URL=

# GitHub + sandbox runner (repo must contain .github/workflows/sandbox.yml)
GITHUB_PAT=your_github_pat
GITHUB_USERNAME=thejasminebot
SANDBOX_REPO=thejasminebot/sand-box
SANDBOX_PRIVATE_REPO=thejasminebot/sand-box
# Defaults to <WEBHOOK_URL host>/api/sandbox/callback
SANDBOX_CALLBACK_URL=

# Email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PERSONAL_EMAIL=

# Token analytics, search, AI social (optional)
CODEX_IO_API_KEY=
TAVILY_API_KEY=
MOLTBOOK_API_KEY=
VERCEL_TOKEN=

# Server. Set WEBHOOK_URL=https://your-host/webhook in production; empty = long polling.
PORT=8080
WEBHOOK_URL=
# Optional fixed webhook secret; a random one is generated each start if empty
WEBHOOK_SECRET=
